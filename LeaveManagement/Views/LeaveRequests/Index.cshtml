@model LeaveManagement.ViewModels.LeaveRequestSearchViewModel

@{
    ViewBag.Title = "My leave requests";
}

<h2>My leave requests</h2>

<p>
    @Html.ActionLink("New request", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("My balances", "Balances", null, new { @class = "btn btn-secondary" })
</p>

@using (Html.BeginForm("Index", "LeaveRequests", FormMethod.Get))
{
    <div class="row mb-3">
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.Search, new { @class = "form-control", placeholder = "Reason" })
        </div>
        <div class="col-md-2">
            @Html.EnumDropDownListFor(m => m.Status, "Any status", new { @class = "form-select" })
        </div>
        <div class="col-md-2">
            @Html.DropDownListFor(m => m.LeaveTypeId, Model.LeaveTypes, "Any type",
                new { @class = "form-select" })
        </div>
        <div class="col-md-2">
            @Html.TextBoxFor(m => m.From, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>
        <div class="col-md-2">
            @Html.TextBoxFor(m => m.To, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
}

<p>@Model.TotalCount request(s) found.</p>

@if (Model.Results.Count == 0)
{
    <p>No requests match your search.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>From</th>
                <th>To</th>
                <th>Days</th>
                <th>Status</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.Results)
            {
                <tr>
                    <td>@request.LeaveType.Name</td>
                    <td>@request.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@request.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@request.TotalDays</td>
                    <td>@request.Status</td>
                    <td>@request.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>@Html.ActionLink("Details", "Details", new { id = request.Id })</td>
                </tr>
            }
        </tbody>
    </table>

    if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        @Html.ActionLink(i.ToString(), "Index", new
                        {
                            search = Model.Search,
                            status = Model.Status,
                            leaveTypeId = Model.LeaveTypeId,
                            from = Model.From,
                            to = Model.To,
                            page = i,
                            pageSize = Model.PageSize
                        }, new { @class = "page-link" })
                    </li>
                }
            </ul>
        </nav>
    }
}