@model LeaveManagement.ViewModels.CreateLeaveRequestViewModel

@{
    ViewBag.Title = "New leave request";
}

<h2>New leave request</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="row mb-3">
        <div class="col-md-2">
            @Html.LabelFor(m => m.LeaveTypeId, new { @class = "col-form-label" })
        </div>
        <div class="col-md-10">
            @Html.DropDownListFor(m => m.LeaveTypeId, Model.LeaveTypes,
                "Choose a type", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.LeaveTypeId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            @Html.LabelFor(m => m.StartDate, new { @class = "col-form-label" })
        </div>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            @Html.LabelFor(m => m.EndDate, new { @class = "col-form-label" })
        </div>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            @Html.LabelFor(m => m.Reason, new { @class = "col-form-label" })
        </div>
        <div class="col-md-10">
            @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-10 offset-md-2">
            <input type="submit" value="Submit request" class="btn btn-primary" />
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}