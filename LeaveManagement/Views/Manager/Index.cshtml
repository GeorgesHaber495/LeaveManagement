@model List<LeaveManagement.Models.Entities.LeaveRequest>

@{
    ViewBag.Title = "All leave requests";
    bool pendingOnly = ViewBag.PendingOnly;
}

<h2>All leave requests</h2>

<p>
    @if (pendingOnly)
    {
        @Html.ActionLink("Show all", "Index", new { pendingOnly = false },
            new { @class = "btn btn-secondary" })
    }
    else
    {
        @Html.ActionLink("Show pending only", "Index", new { pendingOnly = true },
            new { @class = "btn btn-secondary" })
    }
</p>

@if (Model.Count == 0)
{
    <p>There are no requests to show.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Type</th>
                <th>From</th>
                <th>To</th>
                <th>Days</th>
                <th>Status</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.User.FullName</td>
                    <td>@request.LeaveType.Name</td>
                    <td>@request.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@request.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@request.TotalDays</td>
                    <td>@request.Status</td>
                    <td>@request.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>@Html.ActionLink("Review", "Details", new { id = request.Id })</td>
                </tr>
            }
        </tbody>
    </table>
}