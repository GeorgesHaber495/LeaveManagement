          ],
          "query": [
            {
              "key": "from",
              "value": "2026-12-31"
            },
            {
              "key": "to",
              "value": "2026-12-01"
            }
          ]
        },
        "description": "Expected: 400 Bad Request. to cannot be earlier than from."
