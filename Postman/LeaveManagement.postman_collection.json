{
  "info": {
    "_postman_id": "1bd874f3-3931-4970-9756-1491db697d92",
    "name": "Leave Management API",
    "description": "Manager-only endpoint for listing leave requests.\n\nAUTHENTICATION  \nThe API uses the same cookie as the web application, so you must sign in first and copy the cookie across:\n\n1. Run the application and sign in as [manager@demo.local](https://mailto:manager@demo.local) / Demo@123\n    \n2. Press F12 > Application > Cookies > [https://localhost:44390](https://localhost:44390)\n    \n3. Copy the value of .AspNet.ApplicationCookie\n    \n4. Paste it into the collection variable 'authCookie'\n    \n\nAlso turn off SSL certificate verification in Postman settings, because localhost uses a development certificate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58975324",
    "_collection_link": "https://go.postman.co/collection/58975324-1bd874f3-3931-4970-9756-1491db697d92?source=collection_link"
  },
  "item": [
    {
      "name": "All requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": ".AspNet.ApplicationCookie={{authCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leave-requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ]
        },
        "description": "Returns the first page of all leave requests, newest first."
      },
      "response": []
    },
    {
      "name": "Filter by status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": ".AspNet.ApplicationCookie={{authCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leave-requests?status=Pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ],
          "query": [
            {
              "key": "status",
              "value": "Pending"
            }
          ]
        },
        "description": "Valid values: Pending, Approved, Rejected, Cancelled. Not case sensitive."
      },
      "response": []
    },
    {
      "name": "Filter by date range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": ".AspNet.ApplicationCookie={{authCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leave-requests?from=2026-12-01&to=2026-12-31",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ],
          "query": [
            {
              "key": "from",
              "value": "2026-12-01"
            },
            {
              "key": "to",
              "value": "2026-12-31"
            }
          ]
        },
        "description": "Returns any request that touches the range, not only requests fully inside it."
      },
      "response": []
    },
    {
      "name": "Paging",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": ".AspNet.ApplicationCookie={{authCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leave-requests?page=1&pageSize=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "2"
            }
          ]
        },
        "description": "pageSize is capped at 100. The response carries totalCount and totalPages."
      },
      "response": []
    },
    {
      "name": "Invalid status returns 400",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": ".AspNet.ApplicationCookie={{authCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leave-requests?status=banana",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leave-requests"
          ],
          "query": [
            {
              "key": "status",
              "value": "banana"
            }
          ]
        },
        "description": "Expected: 400 Bad Request with a message naming the valid statuses."
      },
      "response": []
    },
    {
